HF_API_BASE_URL=
OPENROUTER_API_BASE=
OPEN_HIGGSFIELD_READ_WRITE_TOKEN=

# MySQL (Laragon). Example:
# DATABASE_URL=mysql://root@127.0.0.1:3306/video_gen
DATABASE_URL=

# 32+ byte secret used to seal session cookies (never commit the real value)
SESSION_SECRET=

# Set true only behind HTTPS. Leave unset/false for http:// (for example a LAN IP).
COOKIE_SECURE=

# App path prefix, like a base_url path (login, API, assets). Host is the
# address already open in the browser, so do not put http:// or a hostname here.
# Example for http://192.168.1.100/video-gen:
# NEXT_PUBLIC_BASE_PATH=/video-gen
# Leave empty for http://localhost:3000. Rebuild after changing this.
NEXT_PUBLIC_BASE_PATH=

# One-time seed via: pnpm db:seed
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
