HF_API_BASE_URL=
OPENROUTER_API_BASE=
OPEN_HIGGSFIELD_READ_WRITE_TOKEN=

# MySQL (Laragon). Example:
# DATABASE_URL=mysql://root@127.0.0.1:3306/video_gen
DATABASE_URL=

# 32+ byte secret used to seal session cookies (never commit the real value)
SESSION_SECRET=

# Set true only behind HTTPS. Leave unset/false for http:// (for example a LAN IP).
COOKIE_SECURE=

# App path prefix, like a base_url path (login, API, assets). Host is the
# address already open in the browser, so do not put http:// or a hostname here.
# Example for http://192.168.1.100/video-gen:
# NEXT_PUBLIC_BASE_PATH=/video-gen
# Leave empty for http://localhost:3000. Rebuild after changing this.
NEXT_PUBLIC_BASE_PATH=

# Local reference files. Default is <app>/uploads when next start runs in the app
# directory (/var/www/html/video-gen). Set this if the process cwd is elsewhere.
# UPLOAD_DIR=/var/www/html/video-gen/uploads
UPLOAD_DIR=

# Reference media and the provider's fetch. With this true, a reference that
# lives on this server (an upload or an archived result) is sent to the provider
# as a signed https address of that file — images and clips alike — which only
# works once the studio answers on public HTTPS, the origin NEXT_PUBLIC_SITE_URL
# names. With it false, images travel inline and a clip is taken from the
# provider's own CDN link when the run kept one. Needs a rebuild to change
# (./deploy.sh rebuilds); the older PUBLIC_MEDIA_HTTPS spelling still works.
# PUBLIC_MEDIA_HTTPS (legacy alias) is read too.
# PUBLIC_MEDIA_HTTPS=false
NEXT_PUBLIC_MEDIA_HTTPS=
# Override the origin used for those signed addresses (https only).
# PUBLIC_MEDIA_ORIGIN=

# One-time seed via: pnpm db:seed
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
